{
	"name": "taskmarks",
	"displayName": "Taskmarks",
	"description": "Little helper for teams to navigate through files. Persists bookmarks for different tasks.",
	"version": "1.1.0",
	"publisher": "NorbertKlein",
	"contributors": [
		"Klein Norbert",
		"Brent Whitehead"
	],
	"engines": {
		"vscode": "^1.76.0"
	},
	"license": "(MIT OR Apache-2.0)",
	"icon": "images/taskmarks-icon.png",
	"categories": [
		"Other"
	],
	"keywords": [
		"Bookmark, Tasks, Remember, Places, Teamwork, Collaboration"
	],
	"activationEvents": [
		"workspaceContains:.vscode/taskmarks.json"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": {
			"title": "Taskmarks",
			"properties": {
				"taskmarks.enableLabel": {
					"type": "boolean",
					"default": false,
					"description": "Enable your own label for marks."
				},
				"taskmarks.useGlobalTaskmarksJson": {
					"type": "boolean",
					"default": false,
					"description": "Keep taskmarks.json in VS Code's storage for this workspace instead of .vscode/taskmarks.json (a .vscode/taskmarks.json that already exists is still used)."
				}
			}
		},
		"keybindings": [
			{
				"command": "taskmarks.toggleMark",
				"key": "ctrl+alt+m",
				"mac": "cmd+alt+m"
			},
			{
				"command": "taskmarks.nextMark",
				"key": "ctrl+alt+n",
				"mac": "cmd+alt+n"
			},
			{
				"command": "taskmarks.previousMark",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p"
			},
			{
				"command": "taskmarks.selectTask",
				"key": "ctrl+alt+t",
				"mac": "cmd+alt+t"
			}
		],
		"commands": [
			{
				"command": "taskmarks.selectMarkFromList",
				"title": "Taskmarks: Select Bookmark from List"
			},
			{
				"command": "taskmarks.selectTask",
				"title": "Taskmarks: Select Active Task"
			},
			{
				"command": "taskmarks.renameTask",
				"title": "Taskmarks: Rename Task"
			},
			{
				"command": "taskmarks.createTask",
				"title": "Taskmarks: Create new Task"
			},
			{
				"command": "taskmarks.deleteTask",
				"title": "Taskmarks: Delete Task"
			},
			{
				"command": "taskmarks.toggleMark",
				"title": "Taskmarks: Toggle Bookmark at Current Position"
			},
			{
				"command": "taskmarks.nextMark",
				"title": "Taskmarks: Find next Bookmark"
			},
			{
				"command": "taskmarks.previousMark",
				"title": "Taskmarks: Find previous Bookmark"
			},
			{
				"command": "taskmarks.copyToClipboard",
				"title": "Taskmarks: Copy Active Task to Clipboard"
			},
			{
				"command": "taskmarks.pasteFromClipboard",
				"title": "Taskmarks: Paste Task from Clipboard"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
		"esbuild": "npm run esbuild-base -- --sourcemap",
		"esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
		"test-compile": "tsc -p ./",
		"prettify": "prettier -l --write \"**/*.ts\"",
		"vscode:prepublishOld": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint --fix src --ext ts",
		"test": "node ./out/test/runTest.js",
		"test:coverage": "npm run compile && nyc instrument ./out ./out-instrumented && cross-env COVERAGE=true node ./out-instrumented/test/runTest.js && nyc report --reporter=html --reporter=text",
		"testAll": "npm run compile && nyc --reporter=html mocha --require ./out/test/mocha-setup.js \"./out/test/**/*.test.js\"",
		"testBoth": "npm run testAll && npm run test",
		"testFile": "npm run compile && nyc --reporter=html mocha --require ./out/test/mocha-setup.js \"./out/test/**/File.test.js\"",
		"checkForUpgrade": "ncu",
		"upgrade": "ncu --upgrade && npm install",
		"inst": "npm install",
		"build package": "npx @vscode/vsce package",
		"publish": "npx @vscode/vsce publish",
		"publish pre-release": "npx @vscode/vsce publish --pre-release"
	},
	"devDependencies": {
		"@types/chai": "^5.0.0",
		"@types/glob": "^9.0.0",
		"@types/mocha": "^10.0.1",
		"@types/node": "26.x",
		"@types/sinon": "^21.0.0",
		"@types/vscode": "^1.76.0",
		"@typescript-eslint/eslint-plugin": "^8.0.1",
		"@typescript-eslint/parser": "^8.0.1",
		"@vscode/test-electron": "^3.0.0",
		"chai": "^6.0.1",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.0.3",
		"glob": "^13.0.0",
		"mocha": "^12.0.2",
		"npm-check-updates": "^22.2.3",
		"nyc": "^18.0.0",
		"prettier": "3.9.9",
		"prettier-eslint-cli": "9.2.1",
		"sinon": "^22.0.0",
		"ts-node": "^10.9.1",
		"typescript": "^7.0.2"
	},
	"nyc": {
		"all": true,
		"include": [
			"out/**/*.js",
			"src/**/*.ts"
		],
		"exclude": [
			"out/test/**",
			"out/main.js",
			"src/test/**"
		]
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/norbertK/taskmarks"
	},
	"homepage": "https://github.com/norbertK/taskmarks/blob/master/README.md"
}
